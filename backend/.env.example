# ---- LLM Provider ----
# Set to 'openai' (default) or 'ollama'
#LLM_PROVIDER=openai

# ---- OpenAI Configuration ----
# https://platform.openai.com/docs/quickstart?context=node
# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=YOUR_API_KEY

# ---- Ollama Configuration ----
# Required when LLM_PROVIDER=ollama
# When running in Docker Compose, use http://ollama:11434/v1
# When running locally, use http://localhost:11434/v1
#OLLAMA_BASE_URL=http://localhost:11434/v1

# Default chat model (e.g. gpt-3.5-turbo for OpenAI, llama3.1 for Ollama)
#DEFAULT_MODEL=gpt-3.5-turbo

# Embedding model (e.g. text-embedding-ada-002 for OpenAI, nomic-embed-text for Ollama)
#EMBEDDING_MODEL=text-embedding-ada-002

# Context window size in tokens for models not in the known list (default: 8192)
#CONTEXT_WINDOW_SIZE=8192

# ---- Session ----
SESSION_SECRET=CHANGE_ME_FOR_EXAMPLE_GENERATE_A_UUID

COOKIE_NAME=SpyLogicLocal.sid
SESSION_EXPIRY_HOURS=8

# If running UI and API separately, this value must match your UI URL.
# Default in development mode is http://localhost:5173, so you don't
# need to uncomment this unless you change the UI port.
# In a production deployment that needs CORS, you must provide a value.
#CORS_ALLOW_ORIGIN=http://localhost:5173
